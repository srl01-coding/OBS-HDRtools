// OBS HDR Toolkit - program denoise
// Copyright (C) 2026 srl01-coding, GPL-2.0-or-later
//
// Runs on the finished program frame (OBS main texture, native canvas space,
// RGBA16F on an HDR canvas). No decode, encode or clamp; alpha passes through.
//
// Identity: exact texel copy (P0 transparency test).
// HQDN3D-style temporal (P1): docs/HQDN3D_DESIGN.md. Independent implementation, no
// FFmpeg/MPlayer code. Mirrored line for line in src/denoise/hqdn3d-math.cpp
// (temporal_pixel_f, global_factor_f, frame_metric_f) and tested there.
// HQDN3D-style spatial B (P2): design section 8.3, mirrored in src/denoise/spatial-math.cpp
// (spatial_b_pass_f) and tested in tests/cpu/test_spatial.cpp.
// Note: identifiers avoid GLSL built-in names (mix, floor, sample).

uniform float4x4 ViewProj;
uniform texture2d image;      // current frame (or a metric level for the reductions)
uniform texture2d hist_tex;   // temporal history (previous filtered frame)
uniform texture2d filt_tex;   // this frame's filtered result (output pass)
uniform texture2d metric_tex; // 1 x 1: r = frame metric m, g = static-noise floor, b = floor valid
uniform texture2d prev_metric_tex;
uniform texture2d src_tex;    // temporal input (after spatial), for the weight view

uniform float2 tex_size = {3840.0, 2160.0}; // full frame
uniform float2 in_size = {1.0, 1.0};        // input of a reduction pass
uniform float2 out_size = {1.0, 1.0};       // render target of the current pass

uniform float nits_per_unit = 203.0;
uniform float units_per_nit = 0.004926108;
uniform float knee = 0.1;          // comparison knee K, nits
uniform float t_luma = 0.0;        // threshold, log2 units (0 = off)
uniform float t_chroma = 0.0;
uniform float m_cut = 0.3;
uniform float protect_amount = 0.8;
uniform float cut_enabled = 1.0;
uniform float reset = 0.0;         // history invalid this frame
uniform float mix_amount = 1.0;
uniform float debug_mode = 0.0;    // 0 normal, 1 difference, 2 history difference, 3 metric bar, 4 exact, 5 weight
uniform float debug_gain = 16.0;
uniform float s_t_luma = 0.0;      // spatial thresholds, log2 units (0 = off)
uniform float s_t_chroma = 0.0;
uniform float s_radius = 8.0;      // 1..12 taps per side
// noise profile T(Y) = T * m(Y) (docs/denoise/NOISE_PROFILE.md), mirrored in
// src/denoise/noise-profile.cpp (profile_multiplier_f). np_count = 0: identity.
uniform float4 np0 = {0.0, 1.0, 0.0, 1.0}; // (log2 nits, multiplier) anchors 0, 1
uniform float4 np1 = {0.0, 1.0, 0.0, 1.0}; // anchors 2, 3
uniform float4 np2 = {0.0, 1.0, 0.0, 1.0}; // anchors 4, 5
uniform float np_count = 0.0;
uniform float np_min = 0.5;
uniform float np_max = 3.0;

struct VertInOut {
	float4 pos : POSITION;
	float2 uv  : TEXCOORD0;
};

VertInOut VSDefault(VertInOut vert_in)
{
	VertInOut vert_out;
	vert_out.pos = mul(float4(vert_in.pos.xyz, 1.0), ViewProj);
	vert_out.uv  = vert_in.uv;
	return vert_out;
}

float luma(float3 c)
{
	return dot(c, float3(0.2126, 0.7152, 0.0722));
}

// F(y) = sign(y) log2(1 + |y| / K), y in nits
float comp(float y)
{
	float a = log2(1.0 + abs(y) / knee);
	return y < 0.0 ? -a : a;
}

// one segment of the piecewise-linear profile (no local arrays or loops: portable to the
// OpenGL translation); the last segment whose start lies below l wins
float profile_seg(float m, float l, float2 a, float2 b, float idx)
{
	if (idx + 1.0 < np_count && l > a.x) {
		float t = clamp((l - a.x) / (b.x - a.x), 0.0, 1.0);
		return a.y + t * (b.y - a.y);
	}
	return m;
}

float profile_mult(float y)
{
	if (np_count < 0.5)
		return 1.0;
	float l = log2(max(abs(y), 0.001));
	float m = np0.y;
	m = profile_seg(m, l, np0.xy, np0.zw, 0.0);
	m = profile_seg(m, l, np0.zw, np1.xy, 1.0);
	m = profile_seg(m, l, np1.xy, np1.zw, 2.0);
	m = profile_seg(m, l, np1.zw, np2.xy, 3.0);
	m = profile_seg(m, l, np2.xy, np2.zw, 4.0);
	return clamp(m, np_min, np_max);
}

float response(float x)
{
	float u = 1.0 - x * x;
	return x < 1.0 ? u * u : 0.0;
}

// ---- Identity (P0) ----------------------------------------------------------

float4 PSIdentity(VertInOut vert_in) : TARGET
{
	int2 p = int2(vert_in.uv * tex_size);
	return image.Load(int3(p, 0));
}

// ---- frame metric (design section 4) ---------------------------------------

// level 1: one texel per 16 x 16 block, 4 x 4 samples at offsets 2, 6, 10, 14
float4 PSMetricBlocks(VertInOut vert_in) : TARGET
{
	int2 b = int2(vert_in.uv * out_size);
	int2 lim = int2(tex_size);
	float sum = 0.0;
	float n = 0.0;
	for (int j = 0; j < 4; j++) {
		for (int i = 0; i < 4; i++) {
			int2 p = b * 16 + int2(2 + 4 * i, 2 + 4 * j);
			if (p.x < lim.x && p.y < lim.y) {
				float yc = luma(image.Load(int3(p, 0)).rgb) * nits_per_unit;
				float yh = luma(hist_tex.Load(int3(p, 0)).rgb) * nits_per_unit;
				sum = sum + abs(comp(yh) - comp(yc));
				n = n + 1.0;
			}
		}
	}
	return float4(sum / max(n, 1.0), 0.0, 0.0, 1.0);
}

// level 2: mean of 16 x 16 blocks of level 1
float4 PSMetricReduce(VertInOut vert_in) : TARGET
{
	int2 b = int2(vert_in.uv * out_size);
	int2 lim = int2(in_size);
	float sum = 0.0;
	float n = 0.0;
	for (int j = 0; j < 16; j++) {
		for (int i = 0; i < 16; i++) {
			int2 p = b * 16 + int2(i, j);
			if (p.x < lim.x && p.y < lim.y) {
				sum = sum + image.Load(int3(p, 0)).r;
				n = n + 1.0;
			}
		}
	}
	return float4(sum / max(n, 1.0), 0.0, 0.0, 1.0);
}

// level 3 (1 x 1): mean of level 2 (up to 32 x 32, i.e. frames up to 8192 px) and
// the static-noise floor: f_next = valid ? min(m, f * 1.005 + 0.0001) : m
float4 PSMetricFinal(VertInOut vert_in) : TARGET
{
	if (reset > 0.5)
		return float4(0.0, 0.0, 0.0, 1.0);
	int2 lim = int2(in_size);
	float sum = 0.0;
	float n = 0.0;
	for (int j = 0; j < 32; j++) {
		for (int i = 0; i < 32; i++) {
			if (i < lim.x && j < lim.y) {
				sum = sum + image.Load(int3(i, j, 0)).r;
				n = n + 1.0;
			}
		}
	}
	float m = sum / max(n, 1.0);
	float4 prev = prev_metric_tex.Load(int3(0, 0, 0));
	float fl = prev.b > 0.5 ? min(m, prev.g * 1.005 + 0.0001) : m;
	return float4(m, fl, 1.0, 1.0);
}

// ---- temporal recurrence (design section 3) ---------------------------------

float global_factor(float m, float fl)
{
	if (reset > 0.5)
		return 0.0;
	if (cut_enabled > 0.5 && m >= m_cut)
		return 0.0;
	float prot = smoothstep(0.0, 0.02, m - 1.5 * fl);
	return 1.0 - protect_amount * prot;
}

// history weights (luma, chroma) for current c and history h, both in nits
float2 temporal_weights(float3 c, float3 h, float g)
{
	float yc = luma(c);
	float yh = luma(h);
	float3 cc = c - float3(yc, yc, yc);
	float3 ch = h - float3(yh, yh, yh);
	float mp = profile_mult(0.5 * (abs(yh) + abs(yc)));
	float tl = t_luma * mp;
	float tc = t_chroma * mp;
	float dl = abs(comp(yh) - comp(yc));
	float3 dv = ch - cc;
	float dc = sqrt(dot(dv, dv)) / (0.5 * (abs(yh) + abs(yc)) + knee) * 1.442695041;
	float wl = tl > 0.0 ? 0.9 * response(dl / tl) * g : 0.0;
	float wc = tc > 0.0 ? 0.9 * response(dc / tc) * g : 0.0;
	return float2(wl, wc);
}

float4 PSTemporal(VertInOut vert_in) : TARGET
{
	int2 p = int2(vert_in.uv * tex_size);
	float4 cur = image.Load(int3(p, 0));
	float4 hist = hist_tex.Load(int3(p, 0));
	float4 mt = metric_tex.Load(int3(0, 0, 0));
	float g = global_factor(mt.r, mt.g);

	float3 c = cur.rgb * nits_per_unit;
	float3 h = hist.rgb * nits_per_unit;
	float yc = luma(c);
	float yh = luma(h);
	float3 cc = c - float3(yc, yc, yc);
	float3 ch = h - float3(yh, yh, yh);
	float2 w = temporal_weights(c, h, g);
	float wl = w.x;
	float wc = w.y;
	if (wl == 0.0 && wc == 0.0)
		return cur; // exact identity
	float yo = yc + wl * (yh - yc);
	float3 o = float3(yo, yo, yo) + cc + wc * (ch - cc);
	return float4(o * units_per_nit, cur.a);
}

// ---- spatial B: symmetric edge-aware kernel, one axis (design section 8.3) -------

float4 spatial_b(int2 p, int2 dir, int n)
{
	float4 ctr = image.Load(int3(p, 0));
	float3 c0 = ctr.rgb * nits_per_unit;
	float y0 = luma(c0);
	float3 ch0 = c0 - float3(y0, y0, y0);
	float mp = profile_mult(abs(y0));
	float tl = s_t_luma * mp;
	float tc = s_t_chroma * mp;
	float f0 = comp(y0);
	float sl = 1.0;
	float sc = 1.0;
	float yacc = y0;
	float3 cacc = ch0;
	float dec = 1.0;
	int pos = p.x * dir.x + p.y * dir.y;
	for (int k = 1; k <= 12; k++) {
		if (float(k) > s_radius)
			break;
		dec = dec * 0.9;
		for (int side = 0; side < 2; side++) {
			int o = side == 0 ? -k : k;
			int j = pos + o;
			if (j >= 0 && j < n) {
				float3 q = image.Load(int3(p + dir * o, 0)).rgb * nits_per_unit;
				float yq = luma(q);
				float3 cq = q - float3(yq, yq, yq);
				float wl = tl > 0.0 ? dec * response(abs(comp(yq) - f0) / tl) : 0.0;
				float3 dv = cq - ch0;
				float dc = sqrt(dot(dv, dv)) / (0.5 * (abs(yq) + abs(y0)) + knee) * 1.442695041;
				float wc = tc > 0.0 ? dec * response(dc / tc) : 0.0;
				sl = sl + wl;
				yacc = yacc + wl * yq;
				sc = sc + wc;
				cacc = cacc + wc * cq;
			}
		}
	}
	if (sl == 1.0 && sc == 1.0)
		return ctr; // exact identity
	float yo = yacc / sl;
	float3 o3 = float3(yo, yo, yo) + cacc / sc;
	return float4(o3 * units_per_nit, ctr.a);
}

float4 PSSpatialH(VertInOut vert_in) : TARGET
{
	int2 p = int2(vert_in.uv * tex_size);
	return spatial_b(p, int2(1, 0), int(tex_size.x));
}

float4 PSSpatialV(VertInOut vert_in) : TARGET
{
	int2 p = int2(vert_in.uv * tex_size);
	return spatial_b(p, int2(0, 1), int(tex_size.y));
}

// ---- output into the program frame (Mix and debug views) -------------------

float4 PSOutput(VertInOut vert_in) : TARGET
{
	int2 p = int2(vert_in.uv * tex_size);
	float4 cur = image.Load(int3(p, 0));
	float4 filt = filt_tex.Load(int3(p, 0));

	if (debug_mode > 4.5) {
		// temporal weight: how much history this frame used (white = 0.9, the maximum;
		// black = current frame only). Luma weight in grey, chroma weight in blue.
		float4 mt = metric_tex.Load(int3(0, 0, 0));
		float g = global_factor(mt.r, mt.g);
		float4 sv = src_tex.Load(int3(p, 0));
		float4 hv = hist_tex.Load(int3(p, 0));
		float2 w = temporal_weights(sv.rgb * nits_per_unit, hv.rgb * nits_per_unit, g) / 0.9;
		return float4(w.x, w.x, 0.5 * (w.x + w.y), 1.0);
	}
	if (debug_mode > 3.5) {
		// exact-value identity check: black = unchanged, magenta = any component changed
		bool same = filt.r == cur.r && filt.g == cur.g && filt.b == cur.b && filt.a == cur.a;
		return same ? float4(0.0, 0.0, 0.0, 1.0) : float4(1.0, 0.0, 1.0, 1.0);
	}
	if (debug_mode > 2.5) {
		// scene-change metric bar along the top: green = normal, amber = protecting,
		// red = cut; white tick = cut threshold, cyan tick = static-noise floor
		float4 mt = metric_tex.Load(int3(0, 0, 0));
		float2 uv = vert_in.uv;
		if (uv.y < 0.03) {
			float full = 1.25 * m_cut;
			float x = uv.x * full;
			float g = global_factor(mt.r, mt.g);
			float3 col = g <= 0.0 ? float3(1.0, 0.1, 0.1) : (g < 0.99 ? float3(1.0, 0.7, 0.0) : float3(0.1, 0.9, 0.2));
			float3 bg = float3(0.05, 0.05, 0.05);
			float3 o = x < mt.r ? col : bg;
			float px = full / out_size.x;
			if (abs(x - m_cut) < 2.0 * px)
				o = float3(1.0, 1.0, 1.0);
			if (abs(x - mt.g) < 2.0 * px)
				o = float3(0.0, 0.9, 1.0);
			return float4(o, 1.0);
		}
		return filt;
	}
	if (debug_mode > 1.5) {
		// what the history differs by (luma, log2 units x gain; 1.0 = SDR white)
		float4 hist = hist_tex.Load(int3(p, 0));
		float d = abs(comp(luma(hist.rgb) * nits_per_unit) - comp(luma(cur.rgb) * nits_per_unit)) * debug_gain;
		return float4(d, d, d, 1.0);
	}
	if (debug_mode > 0.5) {
		// what the filter removed: |output - input| x gain
		return float4(abs(filt.rgb - cur.rgb) * debug_gain, 1.0);
	}
	if (mix_amount >= 1.0)
		return filt;
	if (mix_amount <= 0.0)
		return cur;
	return float4(cur.rgb + mix_amount * (filt.rgb - cur.rgb), cur.a);
}

technique Identity
{
	pass
	{
		vertex_shader = VSDefault(vert_in);
		pixel_shader  = PSIdentity(vert_in);
	}
}

technique MetricBlocks
{
	pass
	{
		vertex_shader = VSDefault(vert_in);
		pixel_shader  = PSMetricBlocks(vert_in);
	}
}

technique MetricReduce
{
	pass
	{
		vertex_shader = VSDefault(vert_in);
		pixel_shader  = PSMetricReduce(vert_in);
	}
}

technique MetricFinal
{
	pass
	{
		vertex_shader = VSDefault(vert_in);
		pixel_shader  = PSMetricFinal(vert_in);
	}
}

technique Temporal
{
	pass
	{
		vertex_shader = VSDefault(vert_in);
		pixel_shader  = PSTemporal(vert_in);
	}
}

technique SpatialH
{
	pass
	{
		vertex_shader = VSDefault(vert_in);
		pixel_shader  = PSSpatialH(vert_in);
	}
}

technique SpatialV
{
	pass
	{
		vertex_shader = VSDefault(vert_in);
		pixel_shader  = PSSpatialV(vert_in);
	}
}

technique Output
{
	pass
	{
		vertex_shader = VSDefault(vert_in);
		pixel_shader  = PSOutput(vert_in);
	}
}
